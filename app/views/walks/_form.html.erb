<% routes = Current.user.routes.by_distance %>
<%= form_with model: walk, class: "flex flex-col gap-4", data: { controller: "route-select" } do |form| %>
  <% if routes.any? %>
    <div class="flex flex-col gap-2">
      <%= form.label :route_id, "Rota" %>
      <%= form.select :route_id,
            routes.map { |route| [ "#{route.name} (#{number_with_precision(route.km, precision: 2, strip_insignificant_zeros: true).tr(".", ",")} km)", route.id, { data: { km: route.km.to_s("F") } } ] },
            { include_blank: "Sem rota" }, class: "field", data: { action: "route-select#fill" } %>
    </div>
  <% end %>

  <div class="flex flex-col gap-2">
    <%= form.label :km, "Quantos km?" %>
    <%= form.text_field :km, value: walk.km&.to_s("F"), required: true, inputmode: "decimal",
          autocomplete: "off", autofocus: walk.new_record?, class: "field text-center text-3xl", data: { route_select_target: "km" } %>
    <% if walk.new_record? %>
      <div class="grid grid-cols-3 gap-2">
        <% [ 2, 3, 5 ].each do |km| %>
          <button type="button" class="btn-game btn-game--secondary"
                  onclick="this.form.elements['walk[km]'].value = '<%= km %>'"><%= km %> km</button>
        <% end %>
      </div>
    <% end %>
    <% walk.errors.full_messages_for(:km).each do |message| %>
      <p class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.label :walked_on, "Quando?" %>
    <%= form.date_field :walked_on, min: walk.walked_on_min, max: Date.current, required: true, class: "field" %>
    <% walk.errors.full_messages_for(:walked_on).each do |message| %>
      <p class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.label :duration, "Tempo (opcional)" %>
    <%= form.text_field :duration, placeholder: "38:51", inputmode: "numeric", autocomplete: "off", class: "field" %>
    <% walk.errors.full_messages_for(:duration).each do |message| %>
      <p class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.label :steps, "Passos (opcional)" %>
    <%= form.text_field :steps, inputmode: "numeric", autocomplete: "off", class: "field" %>
    <% walk.errors.full_messages_for(:steps).each do |message| %>
      <p class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.label :elevation_gain_m, "Subida em metros (opcional)" %>
    <%= form.text_field :elevation_gain_m, inputmode: "numeric", autocomplete: "off", class: "field" %>
    <% walk.errors.full_messages_for(:elevation_gain_m).each do |message| %>
      <p class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.label :load_kg, "Mochila (kg, opcional)" %>
    <%= form.text_field :load_kg, value: walk.load_kg&.to_s("F"), inputmode: "decimal", autocomplete: "off", class: "field" %>
    <% walk.errors.full_messages_for(:load_kg).each do |message| %>
      <p class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.label :note, "Observação (opcional)" %>
    <%= form.text_field :note, maxlength: 140, class: "field" %>
  </div>

  <% if walk.new_record? %>
    <%= link_to "Salvar um caminho novo como rota", new_route_path, class: "caption underline" %>
  <% end %>

  <%= form.submit walk.new_record? ? "Registrar caminhada" : "Salvar", class: "btn-game" %>
<% end %>
