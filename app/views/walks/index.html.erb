<% @page_title = "Histórico" %>

<section class="panel flex flex-col gap-4">
  <h1 class="text-gold">Histórico</h1>

  <% if @entries.any? %>
    <ul class="flex flex-col gap-3">
      <% @entries.each do |entry| %>
        <% stair = entry.is_a?(StairSession) %>
        <li class="flex items-center justify-between gap-3 border-b border-gold/20 pb-3">
          <div>
            <% if stair %>
              <%= stat entry.climb_m.round, unit: "m de escada" %>
              <p class="caption"><%= l entry.climbed_on, format: :long %> · <%= entry.climbs %> subidas<%= " · mochila #{entry.load_kg.to_s("F")} kg" if entry.load_kg %><%= " · #{entry.note}" if entry.note.present? %></p>
            <% else %>
              <%= stat entry.km, unit: "km" %>
              <p class="caption"><%= l entry.walked_on, format: :long %><%= " · #{entry.duration}" if entry.duration_s %><%= " · #{pace(entry.km, entry.duration_s)}" if entry.duration_s %><%= " · #{number_with_delimiter(entry.steps, delimiter: ".")} passos" if entry.steps %><%= " · #{entry.elevation_gain_m} m de subida" if entry.elevation_gain_m %><%= " · mochila #{entry.load_kg.to_s("F")} kg" if entry.load_kg %><%= " · #{entry.note}" if entry.note.present? %></p>
            <% end %>
          </div>
          <div class="flex gap-2">
            <%= link_to "Editar", (stair ? edit_stair_session_path(entry) : edit_walk_path(entry)), class: "btn-game btn-game--secondary text-sm min-h-0 py-2 px-3" %>
            <%= button_to "Excluir", (stair ? stair_session_path(entry) : walk_path(entry)), method: :delete,
                  class: "btn-game btn-game--secondary text-sm min-h-0 py-2 px-3",
                  form: { data: { turbo_confirm: stair ? "Excluir essa subida de escada? Seu progresso vai ser recalculado." : "Excluir essa caminhada? Seu progresso vai ser recalculado." } } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>Nenhuma caminhada ainda. A estrada tá esperando, viajante.</p>
    <%= link_to "Registrar caminhada", new_walk_path, class: "btn-game" %>
  <% end %>
</section>
