<% phase = @journey.current_phase %>

<%= art_tag :scenes, :menu, label: "Pôr do sol nas Três Torres nevadas", class: "scene" %>

<div class="flex flex-col gap-3 min-h-[calc(100dvh-2.5rem)]">
  <header class="text-center mt-14">
    <h1 class="logo">LÉGUAS</h1>
    <p class="eyebrow mt-1">a trilha do vento austral</p>
  </header>

  <div class="flex-1"></div>

  <section class="panel flex items-center gap-3 py-2" data-testid="menu-card">
    <%= art_tag :avatar, :portrait, label: Current.user.name, size: 44, class: "shrink-0" %>
    <div class="flex-1 min-w-0">
      <p class="font-bold"><%= Current.user.name %> · Nv <%= @level.number %> · <%= @level.title.name %></p>
      <p class="caption">Fase <%= phase.number %> · <span class="font-display text-gold"><%= phase.name %></span></p>
      <%= stat @journey.km_in_phase, total: phase.km, unit: "km" %>
    </div>
  </section>

  <nav class="flex flex-col gap-3" aria-label="Menu do jogo">
    <%= link_to "Continuar jornada", phase_path, class: "btn-game text-lg py-4" %>
    <div class="grid grid-cols-2 gap-2">
      <%= link_to "Diário", journal_path, class: "btn-game btn-game--secondary" %>
      <%= link_to "Troféus", trophies_path, class: "btn-game btn-game--secondary" %>
      <%= link_to "Histórico", walks_path, class: "btn-game btn-game--secondary" %>
      <%= link_to "Perfil", edit_profile_path, class: "btn-game btn-game--secondary" %>
    </div>
  </nav>
</div>
