<section class="panel flex flex-col gap-3 lg:gap-2" data-testid="challenges">
  <p class="eyebrow">Trecho <%= week.number %> de <%= phase.weeks.size %><%= " · trecho leve" if week.light? %><%= " · #{week_destination(week, journey)}" if week.landmark %></p>
  <h2>Desafios do trecho</h2>
  <ul class="flex flex-col gap-2 lg:gap-1">
    <% week.challenges.each do |challenge| %>
      <% done = progress.done?(challenge) %>
      <li class="flex items-baseline gap-2 <%= "text-gold" if done %>" data-done="<%= done %>">
        <span aria-hidden="true"><%= done ? "✓" : "☐" %></span>
        <span class="sr-only"><%= done ? "feito" : "a fazer" %></span>
        <span class="flex-1"><%= challenge.label %></span>
        <% unless challenge.kind == :long_walk %>
          <span class="caption"><%= progress.done(challenge) %>/<%= challenge.count %></span>
        <% end %>
        <span class="caption">+<%= challenge.max_xp %> XP</span>
      </li>
    <% end %>
  </ul>
  <% if phase.note %>
    <p class="caption"><%= phase.note %></p>
  <% end %>
</section>
