<% @page_title = "Início" %>

<section class="panel flex items-center gap-4" data-testid="hud">
  <%= link_to edit_profile_path, aria: { label: "Perfil" } do %>
    <%= art_tag :avatar, :portrait, label: Current.user.name, size: 64 %>
  <% end %>
  <div class="flex-1 flex flex-col gap-2">
    <p class="font-bold"><%= Current.user.name %></p>
    <p class="caption"><span class="text-gold">Nível <%= @level.number %></span> · <%= @level.title.name %></p>
    <%= progress_bar @level.progress %>
    <%= stat @level.xp, unit: "XP" %>
    <p class="caption">faltam <%= @level.xp_to_next %> XP pro próximo nível</p>
  </div>
</section>

<section class="panel flex flex-col gap-3" data-testid="phase">
  <% phase = @journey.current_phase %>
  <p class="eyebrow"><%= phase.region.name %> · Fase <%= phase.number %> de <%= phase.region.phases.size %></p>
  <h2 class="<%= phase.legendary? ? "text-legend" : "text-gold" %>"><%= phase.name %></h2>
  <% if phase.focus %>
    <p class="caption"><%= phase.focus %></p>
  <% end %>
  <%= progress_bar @journey.phase_progress %>
  <%= stat @journey.km_in_phase, total: phase.km, unit: "km" %>

  <% if @journey.finished? %>
    <p class="text-gold">Você chegou ao fim do mundo conhecido, viajante! Novas regiões estão a caminho.</p>
  <% elsif (milestone = @journey.next_milestone) && milestone.at_km <= phase.end_km %>
    <% km_to_next = number_with_precision @journey.km_to_next, precision: 1, strip_insignificant_zeros: true %>
    <% if milestone.kind == :boss %>
      <p>O chefe da fase aparece em <strong><%= km_to_next %> km</strong></p>
    <% else %>
      <p>Próximo marco: <strong><%= milestone.subject.name %></strong>, faltam <%= km_to_next %> km</p>
    <% end %>
  <% end %>

  <p class="caption">Total: <%= number_with_precision @journey.total_km, precision: 1, strip_insignificant_zeros: true %> km · <%= @journey.leagues %> léguas<% if @journey.climbed_m > 0 %> · <%= number_with_delimiter @journey.climbed_m.round %> m subidos<% end %></p>
</section>

<% if @week %>
  <%= render "phases/week", week: @week, phase: phase %>
<% elsif @journey.boss_status(phase) == :waiting %>
  <%= render "phases/boss", boss: phase.boss, banked_km: @journey.banked_km %>
<% end %>

<% if tip = tip_of_the_day(phase.region) %>
  <section class="panel">
    <p class="eyebrow">Dica do plano</p>
    <p data-testid="tip"><%= tip %></p>
  </section>
<% end %>

<section class="panel flex flex-col gap-3" data-testid="mission">
  <h2>Missão do dia</h2>
  <% if @walked_today >= @mission_goal %>
    <p class="text-lake font-bold">Missão cumprida! +<%= Mission::XP %> XP</p>
  <% else %>
    <p>Caminhar <%= number_with_precision @mission_goal, precision: 1, strip_insignificant_zeros: true %> km</p>
  <% end %>
  <%= progress_bar @walked_today / @mission_goal, color: :lake %>
  <%= stat @walked_today, total: @mission_goal, unit: "km", color: :lake %>
</section>

<%= link_to "Registrar caminhada", new_walk_path, class: "btn-game text-lg py-4" %>
<%= link_to "Registrar escada", new_stair_session_path, class: "btn-game btn-game--secondary" %>
