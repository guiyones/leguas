<% @page_title = "Mapa" %>
<% @wide = :full %>
<% region = @journey.current_region %>
<% status = @journey.region_status(region) %>

<header class="flex flex-col items-center gap-1 text-center" data-region="<%= region.key %>" data-status="<%= status %>">
  <h1 class="text-gold">Mapa da trilha</h1>
  <p class="eyebrow">Região <%= region.number %> · <%= region.name %> · <%= region.km.to_i %> km ·
    <%= { completed: "Concluída", current: "Em andamento", locked: "Bloqueada" }.fetch(status) %></p>
</header>

<div class="world-map-page" data-controller="world-map">
  <%= render "maps/world", region: region, journey: @journey, layout: :tall %>
  <%= render "maps/world", region: region, journey: @journey, layout: :wide %>

  <% region.phases.each do |phase| %>
    <dialog id="fase-<%= phase.key %>" class="phase-dialog" aria-labelledby="fase-<%= phase.key %>-nome"
      data-action="click->world-map#closeOnBackdrop">
      <%= render "maps/phase", phase: phase, journey: @journey %>
    </dialog>
  <% end %>
</div>
