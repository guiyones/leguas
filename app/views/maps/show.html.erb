<% @page_title = "Mapa" %>
<% @wide = true %>

<div class="split">
  <h1 class="split__title text-gold text-center lg:text-left">Mapa da trilha</h1>

  <div class="split__map">
    <%= render "maps/world", region: @journey.current_region, journey: @journey %>
  </div>

  <div class="split__info">
    <% @journey.world.regions.each do |region| %>
      <%= render "maps/region", region: region, journey: @journey %>
    <% end %>
  </div>
</div>
