<%# O mesmo mapa em dois desenhos: em pé no celular e deitado no computador. %>
<% walked = world_walked_fraction(region, journey)
   id = "world-map-#{layout}"
   view_box = layout == :wide ? "0 0 1000 380" : "0 0 280 600" %>

<div class="world-map world-map--<%= layout %>">
  <svg class="world-map__art" viewBox="<%= view_box %>" role="group" data-testid="world" data-layout="<%= layout %>"
    aria-label="Mapa da região <%= region.name %>">
    <defs>
      <linearGradient id="<%= id %>-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--color-deep)"/>
        <stop offset=".07" style="stop-color: var(--color-sky)"/>
        <stop offset=".16" style="stop-color: var(--color-horizon)"/>
        <stop offset=".26" style="stop-color: var(--color-ridge)"/>
        <stop offset="1" style="stop-color: var(--color-ridge-3)"/>
      </linearGradient>
      <linearGradient id="<%= id %>-granite" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" style="stop-color: var(--color-sky)"/>
        <stop offset=".55" style="stop-color: var(--color-ridge)"/>
        <stop offset="1" style="stop-color: var(--color-ridge-2)"/>
      </linearGradient>
      <linearGradient id="<%= id %>-lake" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--color-horizon); stop-opacity: .55"/>
        <stop offset=".5" style="stop-color: var(--color-lake); stop-opacity: .6"/>
        <stop offset="1" style="stop-color: var(--color-ridge-2); stop-opacity: .9"/>
      </linearGradient>
      <radialGradient id="<%= id %>-glow" r=".5">
        <stop offset="0" style="stop-color: var(--color-glow); stop-opacity: .95"/>
        <stop offset=".5" style="stop-color: var(--color-ember); stop-opacity: .5"/>
        <stop offset="1" style="stop-color: var(--color-ember); stop-opacity: 0"/>
      </radialGradient>
      <radialGradient id="<%= id %>-horizon-glow" r=".5">
        <stop offset="0" style="stop-color: var(--color-horizon); stop-opacity: .7"/>
        <stop offset="1" style="stop-color: var(--color-horizon); stop-opacity: 0"/>
      </radialGradient>
      <radialGradient id="<%= id %>-legend-glow" r=".5">
        <stop offset="0" style="stop-color: var(--color-legend); stop-opacity: .55"/>
        <stop offset="1" style="stop-color: var(--color-legend); stop-opacity: 0"/>
      </radialGradient>
    </defs>

    <g aria-hidden="true">
      <%= render "maps/world_scenery_#{layout}", id: id %>

      <% if walked > 0 %>
        <path class="world-map__walked" d="<%= world_trail(layout).path_d(from: 0, to: walked) %>"/>
      <% end %>
      <% if walked < 1 %>
        <path class="world-map__ahead" d="<%= world_trail(layout).path_d(from: walked, to: 1) %>"/>
      <% end %>
    </g>

    <% world_nodes(region, layout).each do |phase, (x, y)| %>
      <% status = journey.phase_status(phase)
         caption = world_node_caption(phase, status)
         label_x, label_y, anchor = world_label(layout, x, y, caption) %>
      <a href="#fase-<%= phase.key %>" data-world-phase="<%= phase.key %>" data-status="<%= status %>"
        data-action="world-map#open"
        class="world-map__node world-map__node--<%= status %> <%= "world-map__node--legend" if phase.legendary? %>">
        <% case status %>
        <% when :completed %>
          <circle cx="<%= x %>" cy="<%= y %>" r="14" class="world-map__dot world-map__dot--won"/>
          <image href="<%= asset_path "art/insignias/#{phase.key}.svg" %>" x="<%= x - 11 %>" y="<%= y - 11 %>" width="22" height="22"/>
        <% when :current, :boss %>
          <circle cx="<%= x %>" cy="<%= y %>" r="40" fill="url(#<%= id %>-glow)"
            class="<%= status == :boss ? "world-map__ember" : "world-map__glow" %>"/>
          <circle cx="<%= x %>" cy="<%= y %>" r="15" class="world-map__dot world-map__dot--<%= status %>"/>
          <image href="<%= asset_path "art/avatar/traveler.svg" %>" x="<%= x - 15 %>" y="<%= y - 46 %>" width="30" height="38"/>
        <% else %>
          <% if phase.legendary? %>
            <circle cx="<%= x %>" cy="<%= y %>" r="26" fill="url(#<%= id %>-legend-glow)"/>
          <% end %>
          <circle cx="<%= x %>" cy="<%= y %>" r="11" class="world-map__dot"/>
        <% end %>
        <circle cx="<%= x %>" cy="<%= y %>" r="<%= status == :upcoming ? 16 : 20 %>" class="world-map__focus-ring"/>
        <text class="world-map__label" x="<%= label_x %>" y="<%= label_y %>" text-anchor="<%= anchor %>">
          <tspan class="world-map__name"><%= phase.name %></tspan>
          <% if caption %>
            <tspan class="world-map__caption" x="<%= label_x %>" dy="12"><%= caption %></tspan>
          <% end %>
        </text>
      </a>
    <% end %>
  </svg>
</div>
