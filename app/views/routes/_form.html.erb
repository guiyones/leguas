<%= form_with model: route, class: "flex flex-col gap-4" do |form| %>
  <div class="flex flex-col gap-2">
    <%= form.label :name, "Nome da rota" %>
    <%= form.text_field :name, required: true, maxlength: 40, autofocus: route.new_record?, class: "field" %>
    <% route.errors.full_messages_for(:name).each do |message| %>
      <p class="field-error"><%= message %></p>
    <% end %>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.label :km, "Quantos km?" %>
    <%= form.text_field :km, value: route.km&.to_s("F"), required: true, inputmode: "decimal", autocomplete: "off", class: "field" %>
    <% route.errors.full_messages_for(:km).each do |message| %>
      <p class="field-error"><%= message %></p>
    <% end %>
  </div>

  <%= render "shared/duration_fields", form: form %>

  <div class="flex flex-col gap-2" data-controller="route-trace">
    <%= form.label :photo, "Print do mapa (opcional)" %>
    <%= form.file_field :photo, accept: "image/*", class: "field",
          data: { route_trace_target: "file", action: "route-trace#load" } %>
    <%= form.hidden_field :trace, value: "", data: { route_trace_target: "field" } %>
    <div class="overflow-hidden rounded border border-gold/30 empty:hidden [&>svg]:block [&>svg]:w-full"
         data-route-trace-target="preview"></div>
    <p class="text-sm" data-route-trace-target="retry" hidden></p>
    <canvas class="w-full rounded cursor-crosshair" hidden
            data-route-trace-target="canvas" data-action="click->route-trace#pick"></canvas>
  </div>

  <div class="flex flex-col gap-2">
    <%= form.label :note, "Observação (opcional)" %>
    <%= form.text_field :note, maxlength: 140, class: "field" %>
  </div>

  <%= form.submit route.new_record? ? "Salvar rota" : "Salvar", class: "btn-game" %>
<% end %>
