<% phase = achievement.subject %>
<h1 class="<%= phase.boss? ? "text-ember" : "text-gold" %>"><%= phase.boss? ? "Chefe derrotado!" : "Conquista desbloqueada!" %></h1>
<%= art_tag :insignias, phase.key, label: "Insígnia #{phase.name}", size: phase.legendary? ? 160 : 136 %>
<h2>Fase <%= phase.number %> vencida: <%= phase.name %></h2>
<% if phase.boss? %>
  <p>Insígnia: <strong><%= phase.insignia_name %></strong></p>
<% end %>
<p class="caption">Foco: <%= phase.focus %></p>
<%= stat phase.xp, unit: "XP", prefix: "+" %>
