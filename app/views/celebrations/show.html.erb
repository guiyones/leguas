<% @page_title = "Conquista" %>
<% @hide_nav = true %>

<section class="celebration celebration--<%= @achievement.kind %>">
  <%= render @achievement.kind, achievement: @achievement %>

  <%= button_to @achievement.kind == "boss" ? "Aceitar o desafio" : "Continuar", celebration_path,
        params: { key: @achievement.key }, class: "btn-game w-full", form_class: "celebration__action" %>
</section>
