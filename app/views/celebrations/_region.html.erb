<% region = achievement.subject %>
<h1 class="text-gold">NÍVEL COMPLETO!</h1>
<h2><%= region.name %></h2>
<div class="flex flex-wrap justify-center gap-2">
  <% region.phases.each do |phase| %>
    <%= pixel_art_tag PixelArt.find(:insignias, phase.key), size: phase.insignia_size * 3, label: phase.name %>
  <% end %>
</div>
<dl class="grid grid-cols-3 gap-2 w-full text-sm">
  <div class="panel"><dt class="caption">Distância</dt><dd class="font-display text-gold text-lg"><%= region.km.to_i %> km</dd></div>
  <div class="panel"><dt class="caption">Fases</dt><dd class="font-display text-gold text-lg"><%= region.phases.size %></dd></div>
  <div class="panel"><dt class="caption">XP</dt><dd class="font-display text-gold text-lg"><%= region.xp %></dd></div>
</dl>
<% if next_region = region.next %>
  <p>A próxima região te espera: <strong><%= next_region.name %></strong>.</p>
<% else %>
  <p>Você chegou ao fim do mundo conhecido, viajante. Novas regiões estão a caminho.</p>
<% end %>
