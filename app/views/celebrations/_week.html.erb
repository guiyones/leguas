<% week = achievement.subject
   landmark = week.landmark %>
<h1 class="celebration__kicker text-gold">Trecho conquistado!</h1>
<% if landmark %>
  <%= art_tag :stamps, landmark.key, label: "Carimbo dourado #{landmark.name}", size: 180, class: "celebration__art stamp--gold" %>
  <h2 class="celebration__name"><%= landmark.name %></h2>
  <p>Trecho <%= week.number %> da fase <%= week.phase.number %>: <strong><%= week.phase.name %></strong></p>
<% else %>
  <div class="relative">
    <%= art_tag :seals, "week", label: "Selo do trecho #{week.number}", size: 180, class: "celebration__art" %>
    <span class="absolute inset-x-0 top-[22%] text-center text-5xl text-glow" aria-hidden="true"><%= week.number %></span>
  </div>
  <h2 class="celebration__name">Trecho <%= week.number %></h2>
  <p>Fase <%= week.phase.number %>: <strong><%= week.phase.name %></strong></p>
<% end %>
<%= stat User::WeekProgress::COMPLETE_XP, unit: "XP", prefix: "+" %>
