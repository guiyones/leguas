<fieldset data-steps-target="step" class="flex flex-col gap-4">
  <%= form.label :name, "Seu nome de viajante" %>
  <%= form.text_field :name, required: true, maxlength: 20, autofocus: local_assigns.fetch(:autofocus, true), class: "field" %>
  <% user.errors.full_messages_for(:name).each do |message| %>
    <p class="field-error"><%= message %></p>
  <% end %>
</fieldset>

<fieldset data-steps-target="step" class="flex flex-col gap-4">
  <legend class="mb-2">Quanto você costuma andar por dia?</legend>
  <div class="grid grid-cols-4 gap-2">
    <% User::Traveler::DAILY_GOALS.each do |km| %>
      <label class="panel text-center has-checked:border-gold cursor-pointer">
        <%= form.radio_button :daily_goal_km, km, checked: user.daily_goal_km.to_i == km, class: "sr-only" %>
        <span class="font-bold"><%= km %> km</span>
      </label>
    <% end %>
  </div>
  <p class="caption">Essa é a sua missão do dia. Dá pra mudar depois no perfil.</p>
</fieldset>
