<% @page_title = "Início" %>

<section class="panel flex items-center gap-4" data-testid="hud">
  <%= link_to edit_profile_path, aria: { label: "Perfil" } do %>
    <%= pixel_art_tag PixelArt.find(:avatars, Current.user.avatar), size: 64, label: Current.user.name %>
  <% end %>
  <div class="flex-1 flex flex-col gap-2">
    <p class="font-display text-sm"><%= Current.user.name %></p>
    <p class="caption"><span class="text-gold">Nível <%= @level.number %></span> · <%= @level.title.name %></p>
    <%= segmented_progress @level.progress, color: :xp %>
    <%= stat @level.xp, unit: "XP", color: :xp %>
    <p class="caption">faltam <%= @level.xp_to_next %> XP pro próximo nível</p>
  </div>
</section>

<section class="panel flex flex-col gap-3" data-testid="phase">
  <% phase = @journey.current_phase %>
  <p class="caption"><%= phase.region.name %> · Fase <%= phase.number %> de <%= phase.region.phases.size %></p>
  <h2 class="text-gold"><%= phase.name %></h2>
  <% if phase.focus %>
    <p class="caption"><%= phase.focus %></p>
  <% end %>
  <%= segmented_progress @journey.phase_progress %>
  <%= stat @journey.km_in_phase, total: phase.km, unit: "km" %>

  <% if @journey.finished? %>
    <p class="text-gold">Você chegou ao fim do mundo conhecido, viajante! Novas regiões estão a caminho.</p>
  <% elsif (milestone = @journey.next_milestone) && milestone.at_km <= phase.end_km %>
    <p>Próximo marco: <strong><%= milestone.subject.name %></strong>, faltam <%= number_with_precision @journey.km_to_next, precision: 1, strip_insignificant_zeros: true %> km</p>
  <% end %>

  <p class="caption">Total: <%= number_with_precision @journey.total_km, precision: 1, strip_insignificant_zeros: true %> km · <%= @journey.leagues %> léguas<% if @journey.climbed_m > 0 %> · <%= number_with_delimiter @journey.climbed_m.round %> m subidos<% end %></p>
</section>

<% if @week %>
  <%= render "home/week", week: @week, phase: phase %>
<% elsif @journey.boss_status(phase) == :waiting %>
  <%= render "home/boss", boss: phase.boss, banked_km: @journey.banked_km %>
<% end %>

<section class="panel">
  <p class="caption">Dica do plano</p>
  <p data-testid="tip"><%= tip_of_the_day phase.region %></p>
</section>

<section class="panel flex flex-col gap-3" data-testid="mission">
  <h2>Missão do dia</h2>
  <% if @walked_today >= @mission_goal %>
    <p class="text-xp">Missão cumprida! +<%= Mission::XP %> XP</p>
  <% else %>
    <p>Caminhar <%= number_with_precision @mission_goal, precision: 1, strip_insignificant_zeros: true %> km</p>
  <% end %>
  <%= segmented_progress @walked_today / @mission_goal, segments: 6, color: :xp %>
  <%= stat @walked_today, total: @mission_goal, unit: "km", color: :xp %>
</section>

<%= link_to "Registrar caminhada", new_walk_path, class: "btn-game text-sm py-6" %>
