<% @page_title = "Perfil" %>

<section class="panel flex flex-col gap-6">
  <h1 class="text-gold">Perfil</h1>

  <%= form_with model: @user, url: profile_path, method: :patch, class: "flex flex-col gap-6" do |form| %>
    <%= render "travelers/fields", form: form, user: @user, autofocus: false %>
    <div class="flex flex-col gap-2">
      <%= form.label :stair_steps, "Degraus da sua escada" %>
      <%= form.number_field :stair_steps, min: 1, max: 1000, inputmode: "numeric", class: "field" %>
      <p class="caption">Conte da calçada ao topo, sem os patamares.</p>
      <% @user.errors.full_messages_for(:stair_steps).each do |message| %>
        <p class="field-error"><%= message %></p>
      <% end %>
    </div>
    <%= form.submit "Salvar", class: "btn-game" %>
  <% end %>

  <%= button_to "Sair", session_path, method: :delete, class: "btn-game btn-game--secondary w-full" %>
</section>
